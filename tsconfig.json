{
  "compilerOptions": {
    "moduleResolution": "bundler", // or "node16" or "nodenext"
    "module": "ESNext",
    "target": "ESNext",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite-env.d.ts"]
}
